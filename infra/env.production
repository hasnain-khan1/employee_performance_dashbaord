# Production Environment Configuration
DEBUG=False
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-SECRET-KEY-IN-PRODUCTION

# Database Configuration
POSTGRES_DB=epms_prod
POSTGRES_USER=epms_user
POSTGRES_PASSWORD=CHANGE-THIS-TO-A-SECURE-PASSWORD
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=CHANGE-THIS-TO-A-SECURE-REDIS-PASSWORD
REDIS_PORT=6379

# Backend Configuration
BACKEND_PORT=8000
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,backend
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=https://yourdomain.com/api
VITE_APP_TITLE=Employee Performance Management System
NODE_ENV=production

# Nginx Configuration
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
