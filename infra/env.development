# Development Environment Configuration
DEBUG=True
SECRET_KEY=django-insecure-development-key-change-in-production

# Database Configuration
POSTGRES_DB=epms_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
